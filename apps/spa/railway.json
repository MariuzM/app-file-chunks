{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "cd apps/spa && bun run build",
    "watchPatterns": ["/apps/spa/**", "/bun.lock", "/package.json"]
  },
  "deploy": {
    "startCommand": "cd apps/spa && bun run start",
    "healthcheckPath": "/",
    "restartPolicyType": "ON_FAILURE"
  }
}
